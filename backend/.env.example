# ============ GOOGLE GEMINI API ============
# Obtén tu API key gratis en: https://aistudio.google.com/app/apikey
# La key debe empezar con "AIza" o "AQ"
GEMINI_API_KEY=tu_api_key_aqui

# ============ CONFIGURACIÓN DE MODELOS ============
# Modelos disponibles:
# - gemini-3.8-flash (recomendado, 20 req/día)
# - gemini-2.5-flash
# - gemini-flash-latest
# - gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.8-flash

# ============ OLLAMA (FALLBACK LOCAL) ============
# URL de Ollama (por defecto: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Modelo de Ollama a usar (debe estar descargado con: ollama pull mistral:7b)
OLLAMA_MODEL=mistral:7b

# ============ CONFIGURACIÓN DEL BACKEND ============
# Puerto del backend
BACKEND_PORT=8000

# Host del backend
BACKEND_HOST=127.0.0.1

# ============ TIMEOUTS (en segundos) ============
GEMINI_TIMEOUT=30
OLLAMA_TIMEOUT=60

# ============ DELAYS (en segundos) ============
# Delay entre preguntas en auto-resolución
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=120